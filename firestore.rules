rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed-in users can read the catalog. Writes are allowed for signed-in
    // users so the debug build can seed demo products the first time; lock this
    // down (e.g. admins only) before going to production.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Each user can only read / write their own profile.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Users create their own orders and can only read their own orders.
    match /orders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;
    }
  }
}
